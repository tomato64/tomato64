--- pppd/pppd/main.c
+++ pppd/pppd/main.c
@@ -1610,10 +1610,14 @@
 	kill_my_pg(sig);
     notify(sigreceived, sig);
     if (waiting) {
+#if defined(__GNUC__) && __GNUC__ >= 5
 #pragma GCC diagnostic push
 #pragma GCC diagnostic ignored "-Wunused-result"
+#endif
 	write(sigpipe[1], &sig, sizeof(sig));
+#if defined(__GNUC__) && __GNUC__ >= 5
 #pragma GCC diagnostic pop
+#endif
     }
 }
 
