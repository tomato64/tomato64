+			&gw, &flags, &metric, &mask) != 6)
 			continue;
+		/* the most specific route wins, as in the kernel's own lookup */
 		if ((flags & RTF_UP) == (RTF_UP) && (inetaddr.s_addr & mask) == dest &&
