xl2tpd: fix the host route to the peer from 101-tomato-specific

- delete the route again in destroy_tunnel(), as the original Tomato code
  did; the call was lost when the hack was re-applied to a newer xl2tpd,
  so the route outlived the tunnel and xl2tpd itself
- route_add() took the first /proc/net/route entry that matched, usually
  the default route, so a peer on a directly connected subnet got a host
  route via the gateway; use the most specific route, as the kernel does
- clear the whole struct rtentry, not a pointer's worth of it

--- xl2tpd/call.c
+++ xl2tpd/call.c
@@ -682,7 +682,7 @@
         tunnels.head = st;
         tunnels.count++;
         /* Add route to the peer */
-        memset(&st->rt, 0, sizeof(&st->rt));
+        memset(&st->rt, 0, sizeof(st->rt));
         route_add(st->peer.sin_addr, &st->rt);
         return st->self;
     }
--- xl2tpd/xl2tpd.c
+++ xl2tpd/xl2tpd.c
@@ -693,6 +693,7 @@
         close (t->pppox_fd);
     if (t->udp_fd > -1 )
