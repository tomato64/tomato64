+/*
+ * Syncing a receive buffer for the CPU is a cache operation per 32-byte line
+ * on this non-coherent bus, and it dominates the forwarding profile: on a
+ * Netgear R7000 at line rate, more than half of the busy core is spent in
+ * v7_dma_inv_range and friends. Almost none of that work is needed. A frame
+ * that gets forwarded has its payload moved by DMA and never read by the CPU,
+ * and even a frame going up the stack only needs its headers read before
+ * something decides what to do with it.
+ *
+ * So sync only this much for the CPU up front. It covers the receive header
+ * (BGMAC_RX_FRAME_OFFSET) plus the deepest protocol headers the cut-through
+ * hook parses - a Broadcom switch tag, a VLAN tag, a PPPoE session header,
+ * IPv6 and TCP - which come to about 120 bytes. Anything handed to the stack
+ * has the remainder synced first. Broadcom's own driver does the same thing
+ * with a 320-byte window (CTFMAPSZ).
+ */
+#define BGMAC_RX_SYNC_HEAD	192
+
+static bool bgmac_rx_partial_sync = true;
+module_param_named(rx_partial_sync, bgmac_rx_partial_sync, bool, 0644);
+MODULE_PARM_DESC(rx_partial_sync,
+		 "Sync only packet headers for the CPU on receive (default on)");
+
+/*
+ * Where receive buffers come from. A page pool keeps its pages mapped for the
+ * device, so the per-packet dma_map_single() and its whole-buffer invalidate
+ * both disappear - and that invalidate is what is left of the cache
+ * maintenance this driver spends its time on. What replaces it is a sync when
+ * a buffer is recycled, whose length the freeing side chooses: a frame a
+ * cut-through forwarder rewrote the headers of syncs
+ * NETDEV_CUTTHROUGH_DIRTY_LEN instead of the whole buffer, because nothing
+ * past the headers can be dirty (see skb_pp_recycle()).
+ *
+ * One buffer per page, not two: the pool's sync offset is a property of the
+ * pool, so a second buffer in the same page would be synced at the wrong one.
+ *
+ * Turning this off gives the page-fragment allocator back, which is also what
+ * happens if the pool cannot be created. It takes effect when the ring is
+ * refilled, so bring the interface down and up - or boot with
+ * bgmac.rx_page_pool=0, which is the way back in if these buffers ever turn
+ * out to be handed to the MAC with something dirty still in them.
+ */
+static bool bgmac_rx_page_pool = true;
+module_param_named(rx_page_pool, bgmac_rx_page_pool, bool, 0644);
+MODULE_PARM_DESC(rx_page_pool,
+		 "Feed the receive ring from a page pool (default on; takes effect on ifdown/ifup)");
+
+static void bgmac_dma_rx_pool_destroy(struct bgmac_dma_ring *ring)
+{
+	if (ring->pool) {
+		page_pool_destroy(ring->pool);
+		ring->pool = NULL;
+	}
+}
+
+/*
+ * Called from bgmac_dma_init(), so the ring holds no buffers of ours and the
+ * parameter can be acted on. Failure is not fatal: without a pool the ring is
+ * filled from the page allocator exactly as it was before.
+ */
+static void bgmac_dma_rx_pool_init(struct bgmac *bgmac,
+				   struct bgmac_dma_ring *ring)
+{
+	struct page_pool_params pp = {
+		.order		= 0,
+		.pool_size	= BGMAC_RX_RING_SLOTS,
+		.nid		= NUMA_NO_NODE,
+		.dev		= bgmac->dma_dev,
+		.napi		= &bgmac->napi,
+		.dma_dir	= DMA_FROM_DEVICE,
+		.offset		= BGMAC_RX_BUF_OFFSET,
+		.max_len	= BGMAC_RX_BUF_SIZE,
+		.flags		= PP_FLAG_DMA_MAP | PP_FLAG_DMA_SYNC_DEV,
+	};
+	struct page_pool *pool;
+
+	/* A buffer and its skb_shared_info have to fit in one page. */
+	BUILD_BUG_ON(BGMAC_RX_ALLOC_SIZE > PAGE_SIZE);
+	/*
+	 * A recycled cut-through buffer is synced for NETDEV_CUTTHROUGH_DIRTY_LEN
+	 * from the start of the DMA region, so that has to reach past the
+	 * deepest header rewrite - which is measured from the frame, itself
+	 * BGMAC_RX_FRAME_OFFSET into the region.
+	 */
+	BUILD_BUG_ON(BGMAC_RX_FRAME_OFFSET + NETDEV_CUTTHROUGH_HDR_LEN >
+		     NETDEV_CUTTHROUGH_DIRTY_LEN);
+	BUILD_BUG_ON(NETDEV_CUTTHROUGH_DIRTY_LEN > BGMAC_RX_BUF_SIZE);
+
+	if (!READ_ONCE(bgmac_rx_page_pool)) {
+		bgmac_dma_rx_pool_destroy(ring);
+		return;
+	}
+	if (ring->pool)
+		return;
+
+	pool = page_pool_create(&pp);
+	if (IS_ERR(pool)) {
+		netdev_warn(bgmac->net_dev,
+			    "no page pool (%ld), falling back to the page allocator\n",
+			    PTR_ERR(pool));
+		return;
+	}
+	ring->pool = pool;
+}
+
+/*
+ * Drop the mapping without any cache work: every sync this path needs has
+ * already been done explicitly. On the forwarded path this runs after the
+ * frame has been handed on, which is a no-op here (dma-direct, no IOMMU).
+ */
+static void bgmac_dma_rx_unmap(struct device *dma_dev, dma_addr_t dma_addr)
+{
+	dma_unmap_single_attrs(dma_dev, dma_addr, BGMAC_RX_BUF_SIZE,
+			       DMA_FROM_DEVICE, DMA_ATTR_SKIP_CPU_SYNC);
+}
+
+/*
+ * Give up on a received buffer whose contents we are not going to use: back to
+ * the pool it came from, or to the page allocator. Whatever is in it may be
+ * anything, so the pool syncs the whole buffer for the device again.
+ */
+static void bgmac_dma_rx_drop_buf(struct bgmac_dma_ring *ring,
+				  struct device *dma_dev, void *buf,
+				  dma_addr_t dma_addr)
+{
+	if (ring->pool) {
+		page_pool_put_full_page(ring->pool, virt_to_head_page(buf),
+					true);
+		return;
+	}
+
+	bgmac_dma_rx_unmap(dma_dev, dma_addr);
+	put_page(virt_to_head_page(buf));
+}
