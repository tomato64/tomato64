diff --git a/net/core/cutthrough.c b/net/core/cutthrough.c
new file mode 100644
index 0000000..49eee8c
--- /dev/null
+++ b/net/core/cutthrough.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cut-through forwarding hook: see linux/netdev_cutthrough.h.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdev_cutthrough.h>
+#include <linux/rcupdate.h>
+
+static const struct netdev_cutthrough_ops __rcu *cutthrough_ops;
+static DEFINE_MUTEX(cutthrough_lock);
+
+int netdev_cutthrough_register(const struct netdev_cutthrough_ops *ops)
+{
+	int err = 0;
+
+	if (!ops || !ops->rx || !ops->setup_tc)
+		return -EINVAL;
+
+	mutex_lock(&cutthrough_lock);
+	if (rcu_access_pointer(cutthrough_ops))
+		err = -EBUSY;
+	else
+		rcu_assign_pointer(cutthrough_ops, ops);
+	mutex_unlock(&cutthrough_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(netdev_cutthrough_register);
+
+void netdev_cutthrough_unregister(const struct netdev_cutthrough_ops *ops)
+{
+	mutex_lock(&cutthrough_lock);
+	if (rcu_access_pointer(cutthrough_ops) == ops)
+		RCU_INIT_POINTER(cutthrough_ops, NULL);
+	mutex_unlock(&cutthrough_lock);
+
+	/* No receive path may still be inside ops->rx() when we return. */
+	synchronize_net();
+}
+EXPORT_SYMBOL_GPL(netdev_cutthrough_unregister);
+
+bool netdev_cutthrough_rx(struct net_device *dev, struct sk_buff *skb)
+{
+	const struct netdev_cutthrough_ops *ops;
+	bool consumed = false;
+
+	rcu_read_lock();
+	ops = rcu_dereference(cutthrough_ops);
+	if (ops)
+		consumed = ops->rx(dev, skb);
+	rcu_read_unlock();
+
+	return consumed;
+}
+EXPORT_SYMBOL_GPL(netdev_cutthrough_rx);
+
+int netdev_cutthrough_setup_tc(struct net_device *dev, enum tc_setup_type type,
+			       void *type_data)
+{
+	const struct netdev_cutthrough_ops *ops;
+	int err = -EOPNOTSUPP;
+
+	mutex_lock(&cutthrough_lock);
+	ops = rcu_dereference_protected(cutthrough_ops,
+					lockdep_is_held(&cutthrough_lock));
+	if (ops && try_module_get(ops->owner)) {
+		err = ops->setup_tc(dev, type, type_data);
+		module_put(ops->owner);
+	}
+	mutex_unlock(&cutthrough_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(netdev_cutthrough_setup_tc);
diff --git a/net/core/skbuff.c b/net/core/skbuff.c
index f769fa0..94b3f6b 100644
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -51,6 +51,7 @@
 #endif
 #include <linux/string.h>
 #include <linux/skbuff.h>
+#include <linux/netdev_cutthrough.h>
 #include <linux/skbuff_ref.h>
 #include <linux/splice.h>
 #include <linux/cache.h>
@@ -1047,12 +1048,42 @@ bool napi_pp_put_page(netmem_ref netmem)
 	return true;
 }
 EXPORT_SYMBOL(napi_pp_put_page);
+
+/*
+ * Same, for a buffer a cut-through forwarder only rewrote the headers of.
+ *
+ * Returning a page to its pool syncs it for the device again, because the CPU
+ * may have dirtied it while it was out. On a non-coherent bus that is a cache
+ * operation per line over the whole buffer, and for these frames nearly all of
+ * it is wasted: the payload arrived by DMA and was never written by the CPU,
+ * so nothing past the headers can be dirty. Sync only that much.
+ *
+ * Anything beyond it is left stale in the cache rather than dirty, which the
+ * device does not care about - the driver invalidates what it is about to read
+ * before it reads it.
+ */
+static bool napi_pp_put_page_hdr_only(netmem_ref netmem)
+{
+	netmem = netmem_compound_head(netmem);
+
+	if (unlikely(!netmem_is_pp(netmem)))
+		return false;
+
+	page_pool_put_netmem(netmem_get_pp(netmem), netmem,
+			     NETDEV_CUTTHROUGH_DIRTY_LEN, false);
+
+	return true;
+}
 #endif
 
 static bool skb_pp_recycle(struct sk_buff *skb, void *data)
 {
 	if (!IS_ENABLED(CONFIG_PAGE_POOL) || !skb->pp_recycle)
 		return false;
+#if IS_ENABLED(CONFIG_PAGE_POOL)
+	if (skb->cutthrough_hdr_only)
+		return napi_pp_put_page_hdr_only(page_to_netmem(virt_to_page(data)));
+#endif
 	return napi_pp_put_page(page_to_netmem(virt_to_page(data)));
 }
 
