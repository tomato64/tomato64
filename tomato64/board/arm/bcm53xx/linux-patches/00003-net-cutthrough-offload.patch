+	 * packet - which on an ARM SoC is a cache operation per 32-byte line.
+	 */
+	__u8			cutthrough_hdr_only:1;
 	__u8			tc_depth:2;
 #if defined(CONFIG_NET_SCHED) || defined(CONFIG_NET_XGRESS)
 	__u16			tc_index;	/* traffic control index */
