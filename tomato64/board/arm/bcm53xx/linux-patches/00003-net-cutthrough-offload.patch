@@ -1012,6 +1012,14 @@ struct sk_buff {
 	__u8			csum_not_inet:1;
 #endif
 	__u8			unreadable:1;
+	/*
+	 * Set by a cut-through forwarder (see linux/netdev_cutthrough.h) on a
+	 * frame it received by DMA and only rewrote the headers of. Its
+	 * payload was never written by the CPU, so a driver transmitting it on
