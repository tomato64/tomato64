diff --git a/include/linux/netdev_cutthrough.h b/include/linux/netdev_cutthrough.h
new file mode 100644
index 0000000..11ad13f
--- /dev/null
+++ b/include/linux/netdev_cutthrough.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cut-through forwarding hook.
+ *
+ * Lets one module take over forwarding for flows the kernel has already
+ * decided to offload, at the point a driver receives a frame - before
+ * eth_type_trans(), GRO, RPS and the rest of the receive path.
+ *
+ * Two sides:
+ *
+ *  - Drivers offer received frames with netdev_cutthrough_rx(), and forward
+ *    ndo_setup_tc() with netdev_cutthrough_setup_tc() so the netfilter
+ *    flowtable's hardware offload requests (TC_SETUP_FT) reach the module.
+ *
+ *  - The module registers with netdev_cutthrough_register().
+ *
+ * This lives in net/core rather than in one driver because more than one
+ * receive path feeds it (on Northstar: bgmac, and Broadcom's wl driver), and
+ * a built-in home means neither has to be loaded before the other.
+ *
+ * With nothing registered, every entry point is a NULL check.
+ */
+#ifndef _LINUX_NETDEV_CUTTHROUGH_H
+#define _LINUX_NETDEV_CUTTHROUGH_H
+
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+
+/*
+ * How much of a frame a cut-through forwarder may have written.
+ *
+ * A forwarded frame arrived by DMA and had only its headers rewritten, which
+ * is what skb->cutthrough_hdr_only says. These two numbers put a bound on
+ * "only its headers", so that a driver on a non-coherent bus can write back
+ * or invalidate that much instead of the whole packet.
+ *
+ * NETDEV_CUTTHROUGH_HDR_LEN is measured from skb->data on transmit: the
+ * deepest rewrite is an Ethernet header, a VLAN tag, a PPPoE header, IPv6 and
+ * TCP, and the forwarder trims anything past the payload it does not touch.
+ *
+ * NETDEV_CUTTHROUGH_DIRTY_LEN is measured from the start of the receive
+ * buffer's DMA region, so it also has to cover whatever the driver leaves in
+ * front of the frame - a receive descriptor, alignment padding - and the fact
+ * that pushing a tag moves skb->data backwards. Generous on purpose; it is
+ * still a fifth of a 1566-byte buffer. Broadcom's own driver used 320 here
+ * (CTFMAPSZ) for the same reason.
+ */
+#define NETDEV_CUTTHROUGH_HDR_LEN	192
+#define NETDEV_CUTTHROUGH_DIRTY_LEN	320
+
+struct netdev_cutthrough_ops {
+	struct module *owner;
+
+	/*
+	 * Called for a received frame, inside an RCU read-side section.
+	 * skb->data points at the start of the Ethernet header, or, if the
+	 * driver has already run eth_type_trans(), at the payload with
+	 * skb_mac_header() naming the header. The frame is linear and its
+	 * FCS is stripped; it may carry a DSA tag.
+	 *
+	 * Return true if the skb was consumed (transmitted or freed), false
+	 * if it was left untouched for the normal receive path.
+	 */
+	bool (*rx)(struct net_device *dev, struct sk_buff *skb);
+
+	/* ndo_setup_tc(), forwarded unchanged. May sleep. */
+	int (*setup_tc)(struct net_device *dev, enum tc_setup_type type,
+			void *type_data);
+};
+
+int netdev_cutthrough_register(const struct netdev_cutthrough_ops *ops);
+void netdev_cutthrough_unregister(const struct netdev_cutthrough_ops *ops);
+
+bool netdev_cutthrough_rx(struct net_device *dev, struct sk_buff *skb);
+int netdev_cutthrough_setup_tc(struct net_device *dev, enum tc_setup_type type,
+			       void *type_data);
+
+#endif /* _LINUX_NETDEV_CUTTHROUGH_H */
