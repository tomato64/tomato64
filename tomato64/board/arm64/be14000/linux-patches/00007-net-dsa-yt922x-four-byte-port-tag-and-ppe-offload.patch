Subject: [PATCH] net: dsa: yt922x: four-byte port tag and PPE offload

Backport of two patches from JiaY-shi's OpenWrt tree
(github.com/JiaY-shi/openwrt, branch flint4-support,
target/linux/mediatek/patches-6.18):

  967-40 net: dsa: yt922x: add selectable four-byte port tagging
  967-41 net: ethernet: mediatek: offload YT922x four-byte port tags

The MediaTek PPE cannot parse or insert the YT922x eight-byte CPU tag,
so flows through the YT9224 (SFP+ and the 2.5G ports) were never bound
in hardware. The four-byte tag is VLAN-shaped (TPID 0x8100, port in the
TCI), which the PPE pushes as an ordinary VLAN layer. It is selected
with dsa-tag-protocol = "yt922x_4b" on the CPU port; the eight-byte
protocol stays the driver default.

Differences from the originals:
  - DSA_TAG_PROTO_YT922X_4B_VALUE is 32 (next free value on 6.12).
  - The dt-bindings hunk is dropped.
  - Both YT922x taggers set skb queue_mapping to dp->index, as tag_mtk
    does, so mtk_select_queue() picks the per-port QDMA queue.

Depends on 00006.
---
--- a/drivers/net/dsa/yt921x.c
+++ b/drivers/net/dsa/yt921x.c
@@ -4068,30 +4068,66 @@
 	return 0;
 }
 
-static int yt922x_cpu_tag_mode_set_8b(struct yt921x_priv *priv)
+static int yt922x_cpu_tag_mode_set(struct yt921x_priv *priv,
+				   enum dsa_tag_protocol proto)
 {
-	u32 val;
-	u32 val1;
-	int res;
+	static const u32 regs[] = {
+		YT921X_CPU_TAG_TPID,
+		YT922X_CPU_TAG_RX_CTRL,
+		YT922X_CPU_TAG_TX_CTRL,
+	};
+	u32 saved[ARRAY_SIZE(regs)], next[ARRAY_SIZE(regs)];
+	bool four_byte = proto == DSA_TAG_PROTO_YT922X_4B;
+	int i, res, err;
 
-	/* cpu tag mode set to 8b*/
-	res = yt921x_reg_read(priv, YT922X_CPU_TAG_RX_CTRL, &val);
-	if (res)
-		return res;
-	res = yt921x_reg_read(priv, YT922X_CPU_TAG_TX_CTRL, &val1);
-	if (res)
-		return res;
-	val &= ~YT922X_CPU_TAG_RX_MODE;
-	val1 &= ~YT922X_CPU_TAG_TX_MODE;
-	val1 &= ~YT922X_CPU_TAG_TX_TYPE;
-	res = yt921x_reg_write(priv, YT922X_CPU_TAG_RX_CTRL, val);
-	if (res)
-		return res;
-	res = yt921x_reg_write(priv, YT922X_CPU_TAG_TX_CTRL, val1);
-	if (res)
-		return res;
+	if (proto != DSA_TAG_PROTO_YT922X && !four_byte)
+		return -EOPNOTSUPP;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		res = yt921x_reg_read(priv, regs[i], &saved[i]);
+		if (res)
+			return res;
+		next[i] = saved[i];
+	}
+	next[0] &= ~YT921X_CPU_TAG_TPID_TPID_M;
+	next[0] |= FIELD_PREP(YT921X_CPU_TAG_TPID_TPID_M,
+			      four_byte ? ETH_P_8021Q : ETH_P_YT921X);
+	next[1] &= ~YT922X_CPU_TAG_RX_MODE;
+	next[2] &= ~(YT922X_CPU_TAG_TX_MODE | YT922X_CPU_TAG_TX_TYPE);
+	if (four_byte) {
+		next[1] |= YT922X_CPU_TAG_RX_MODE;
+		next[2] |= YT922X_CPU_TAG_TX_MODE;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		res = yt921x_reg_write(priv, regs[i], next[i]);
+		if (res)
+			goto restore;
+	}
 
 	return 0;
+
+restore:
+	for (i = ARRAY_SIZE(regs) - 1; i >= 0; i--) {
+		err = yt921x_reg_write(priv, regs[i], saved[i]);
+		if (err)
+			dev_err(to_device(priv), "Failed to restore tag register %#x: %d\n",
+				regs[i], err);
+	}
+	return res;
+}
+
+static int yt922x_dsa_change_tag_protocol(struct dsa_switch *ds,
+					  enum dsa_tag_protocol proto)
+{
+	struct yt921x_priv *priv = to_yt921x_priv(ds);
+	int res;
+
+	mutex_lock(&priv->reg_lock);
+	res = yt922x_cpu_tag_mode_set(priv, proto);
+	mutex_unlock(&priv->reg_lock);
+
+	return res;
 }
 
 static int yt922x_cpu_port_set(struct yt921x_priv *priv)
@@ -4101,7 +4137,7 @@
 	int res;
 
 	/* cpu tag mode */
-	res = yt922x_cpu_tag_mode_set_8b(priv);
+	res = yt922x_cpu_tag_mode_set(priv, DSA_TAG_PROTO_YT922X);
 	if (res)
 		return res;
 
@@ -4181,6 +4217,7 @@
 static const struct dsa_switch_ops yt922x_dsa_switch_ops = {
 	/* port */
 	.get_tag_protocol	= yt922x_dsa_get_tag_protocol,
+	.change_tag_protocol	= yt922x_dsa_change_tag_protocol,
 	.phylink_get_caps	= yt922x_dsa_phylink_get_caps,
 	.port_setup		= yt922x_dsa_port_setup,
 	/* chip */
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -10,6 +10,7 @@
 #include <net/flow_offload.h>
 #include <net/pkt_cls.h>
 #include <net/dsa.h>
+#include <linux/dsa/yt922x.h>
 #include "mtk_eth_soc.h"
 #include "mtk_wed.h"
 
@@ -172,7 +173,8 @@
  * *push_vid hand back either 0 (native MTK tag; the PPE injects its
  * magic etype later via mtk_foe_entry_set_dsa()) or the outer 802.1Q
  * VID the PPE should push on the egressing frame (taggers that use an
- * outer VLAN-shaped tag).
+ * outer VLAN-shaped tag), i.e. the full VLAN TCI of the YT922x
+ * four-byte port tag.
  *
  * push_vid may be NULL for callers that only want the idev->conduit
  * substitution (e.g. ingress-side ppe_idx selection, where no VID
@@ -193,6 +195,12 @@
 		if (push_vid)
 			*push_vid = 0;
 		break;
+	case DSA_TAG_PROTO_YT922X_4B:
+		if (!yt922x_4b_port_tag(dp->index))
+			return -ENODEV;
+		if (push_vid)
+			*push_vid = yt922x_4b_port_tag(dp->index);
+		break;
 	default:
 		return -ENODEV;
 	}
@@ -208,11 +216,11 @@
 static int
 mtk_flow_set_output_device(struct mtk_eth *eth, struct mtk_foe_entry *foe,
 			   struct net_device *dev, const u8 *dest_mac,
-			   int *wed_index)
+			   int *wed_index, unsigned int num_vlans)
 {
 	struct mtk_wdma_info info = {};
 	struct mtk_mac *mac;
-	int pse_port, dsa_port, queue;
+	int pse_port, dsa_port, queue, err;
 	u16 push_vid = 0;
 
 	if (mtk_flow_get_wdma_info(dev, dest_mac, &info) == 0) {
@@ -251,10 +259,18 @@
 		return -EOPNOTSUPP;
 
 	if (dsa_port >= 0) {
-		if (push_vid)
-			mtk_foe_entry_set_vlan(eth, foe, push_vid);
-		else
+		if (push_vid) {
+			/* Reserve one of the PPE's two VLAN slots for the CPU tag.
+			 * Preserve the full TCI: YT9224 port 7 uses bit 12 (DEI).
+			 */
+			if (num_vlans >= 2)
+				return -EOPNOTSUPP;
+			err = mtk_foe_entry_set_vlan(eth, foe, push_vid);
+			if (err)
+				return err;
+		} else {
 			mtk_foe_entry_set_dsa(eth, foe, dsa_port);
+		}
 	}
 
 	if (dsa_port >= 0 && dsa_port < MTK_DSA_USER_PORT_MAX) {
@@ -511,7 +527,7 @@
 	}
 
 	err = mtk_flow_set_output_device(eth, &foe, odev, data.eth.h_dest,
-					 &wed_index);
+					 &wed_index, data.vlan.num);
 	if (err)
 		return err;
 
--- /dev/null
+++ b/include/linux/dsa/yt922x.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef _LINUX_DSA_YT922X_H
+#define _LINUX_DSA_YT922X_H
+
+#include <linux/bitfield.h>
+#include <linux/types.h>
+
+/* YT9224 four-byte port tag, following the configurable two-byte TPID.
+ * TX: one destination bit per physical port, starting at bit 5.
+ * RX: source physical port in bits 7:4. Customer VLAN tags follow this tag.
+ * Do not reuse the eight-byte format's force-destination or priority bits.
+ */
+#define YT922X_4B_TX_PORT_M	GENMASK(13, 5)
+#define YT922X_4B_RX_PORT_M	GENMASK(7, 4)
+
+static inline u16 yt922x_4b_port_tag(unsigned int port)
+{
+	if (port > 8)
+		return 0;
+
+	return FIELD_PREP(YT922X_4B_TX_PORT_M, BIT(port));
+}
+
+#endif
--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -57,6 +57,7 @@
 #define DSA_TAG_PROTO_BRCM_LEGACY_FCS_VALUE	29
 #define DSA_TAG_PROTO_YT921X_VALUE		30
 #define DSA_TAG_PROTO_YT922X_VALUE		31
+#define DSA_TAG_PROTO_YT922X_4B_VALUE		32
 
 enum dsa_tag_protocol {
 	DSA_TAG_PROTO_NONE		= DSA_TAG_PROTO_NONE_VALUE,
@@ -91,6 +92,7 @@
 	DSA_TAG_PROTO_VSC73XX_8021Q	= DSA_TAG_PROTO_VSC73XX_8021Q_VALUE,
 	DSA_TAG_PROTO_YT921X		= DSA_TAG_PROTO_YT921X_VALUE,
 	DSA_TAG_PROTO_YT922X		= DSA_TAG_PROTO_YT922X_VALUE,
+	DSA_TAG_PROTO_YT922X_4B		= DSA_TAG_PROTO_YT922X_4B_VALUE,
 };
 
 struct dsa_switch;
--- a/net/dsa/tag_yt922x.c
+++ b/net/dsa/tag_yt922x.c
@@ -7,6 +7,7 @@
  */
 
 #include <linux/etherdevice.h>
+#include <linux/dsa/yt922x.h>
 
 #include "tag.h"
 
@@ -33,6 +34,8 @@
 	__be16 *tag;
 	u16 ctrl;
 
+	skb_set_queue_mapping(skb, dp->index);
+
 	skb_push(skb, YT922X_TAG_LEN);
 	dsa_alloc_etype_header(skb, YT922X_TAG_LEN);
 	tag = dsa_etype_header_pos_tx(skb);
@@ -101,8 +104,79 @@
 	.needed_headroom = YT922X_TAG_LEN,
 };
 
-MODULE_DESCRIPTION("DSA tag driver for Motorcomm YT922x switches");
-MODULE_LICENSE("GPL");
+static struct sk_buff *
+yt922x_4b_tag_xmit(struct sk_buff *skb, struct net_device *netdev)
+{
+	struct dsa_port *dp = dsa_user_to_port(netdev);
+	u16 ctrl = yt922x_4b_port_tag(dp->index);
+	__be16 *tag;
+
+	if (unlikely(!ctrl))
+		return NULL;
+
+	skb_set_queue_mapping(skb, dp->index);
+
+	skb_push(skb, VLAN_HLEN);
+	dsa_alloc_etype_header(skb, VLAN_HLEN);
+	tag = dsa_etype_header_pos_tx(skb);
+	tag[0] = htons(ETH_P_8021Q);
+	tag[1] = htons(ctrl);
+
+	return skb;
+}
+
+static struct sk_buff *
+yt922x_4b_tag_rcv(struct sk_buff *skb, struct net_device *netdev)
+{
+	struct net_device *user;
+	unsigned int port;
+	u16 ctrl;
+
+	if (skb_vlan_tag_present(skb)) {
+		if (unlikely(skb->vlan_proto != htons(ETH_P_8021Q)))
+			return NULL;
+		ctrl = skb_vlan_tag_get(skb);
+		__vlan_hwaccel_clear_tag(skb);
+	} else {
+		__be16 *tag;
+
+		if (unlikely(!pskb_may_pull(skb, VLAN_HLEN)))
+			return NULL;
+		tag = dsa_etype_header_pos_rx(skb);
+		if (unlikely(tag[0] != htons(ETH_P_8021Q)))
+			return NULL;
+		ctrl = ntohs(tag[1]);
+		skb_pull_rcsum(skb, VLAN_HLEN);
+		dsa_strip_etype_header(skb, VLAN_HLEN);
+	}
+
+	port = FIELD_GET(YT922X_4B_RX_PORT_M, ctrl);
+	user = dsa_conduit_find_user(netdev, 0, port);
+	if (unlikely(!user))
+		return NULL;
+	skb->dev = user;
+
+	return skb;
+}
+
+static const struct dsa_device_ops yt922x_4b_netdev_ops = {
+	.name = "yt922x_4b",
+	.proto = DSA_TAG_PROTO_YT922X_4B,
+	.xmit = yt922x_4b_tag_xmit,
+	.rcv = yt922x_4b_tag_rcv,
+	.needed_headroom = VLAN_HLEN,
+};
+
+DSA_TAG_DRIVER(yt922x_netdev_ops);
+DSA_TAG_DRIVER(yt922x_4b_netdev_ops);
 MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_YT922X, YT922X_TAG_NAME);
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_YT922X_4B, "yt922x_4b");
 
-module_dsa_tag_driver(yt922x_netdev_ops);
+static struct dsa_tag_driver *yt922x_tag_drivers[] = {
+	&DSA_TAG_DRIVER_NAME(yt922x_netdev_ops),
+	&DSA_TAG_DRIVER_NAME(yt922x_4b_netdev_ops),
+};
+module_dsa_tag_drivers(yt922x_tag_drivers);
+
+MODULE_DESCRIPTION("DSA tag driver for Motorcomm YT922x switches");
+MODULE_LICENSE("GPL");
