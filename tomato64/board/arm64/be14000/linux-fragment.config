# GL-BE14000 additions on top of board/arm64/common/mediatek/linux.config.
# Edit this file by hand: linux-update-defconfig refuses to run with fragments.

# YT9224 switch, YT8824 2.5G PHYs, SFP+ cage
CONFIG_NET_DSA_YT92XX=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_SFP=y

# Front panel: touch, panel and backlight
CONFIG_INPUT_EVDEV=y
CONFIG_I2C_GPIO=y
CONFIG_DRM=y
CONFIG_DRM_PANEL_MIPI_DBI=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
