# Tenda BE12 Pro overrides on top of board/arm64/common/mediatek/linux.config.
# Edit this file by hand: linux-update-defconfig refuses to run with fragments.
#
# The kernel FIT (plus Tenda's 16-byte God1 header) has to fit the 6 MiB raw
# "kernel" partition of the OpenWrt flash layout, and the shared MediaTek
# config is ~1.1 MB too big for that. Everything below is either hardware this
# board doesn't have (no USB port, no SD/eMMC, no fan) or a driver for one of
# the other MediaTek boards. post-image.sh fails the build if it still
# doesn't fit.

# No USB port: host controllers, USB PHYs, storage, serial, modems, usbnet
# adapters, gadget and HID all go with it
# CONFIG_USB_SUPPORT is not set
# CONFIG_PHY_MTK_TPHY is not set
# CONFIG_PHY_MTK_XSPHY is not set

# No block devices to attach
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MMC is not set

# Filesystems for USB/SD storage. squashfs, UBIFS and overlayfs (the rootfs
# and its overlay) stay, so does CIFS for network shares
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_JFFS2_FS is not set

# NFS client and server (RC_NFS is off for this board)
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set

# Switches, PHYs and peripherals of the other MediaTek boards
# CONFIG_NET_DSA_MT7530 is not set
# CONFIG_AIROHA_EN8801SC_PHY is not set
# CONFIG_ICPLUS_PHY is not set
# CONFIG_REALTEK_PHY is not set
# CONFIG_RTL8261N_PHY is not set
# CONFIG_PCS_MTK_USXGMII is not set
# CONFIG_PHY_MTK_XFI_TPHY is not set
# CONFIG_LEDS_SMARTRG_LED is not set
# CONFIG_SENSORS_PWM_FAN is not set

# /proc/config.gz
# CONFIG_IKCONFIG is not set
