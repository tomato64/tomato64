# switch4g explicitly loads and unloads these drivers with modprobe/rmmod.
# Keep usbnet built-in because it is shared by other USB Ethernet drivers.
CONFIG_MODULES=y
CONFIG_USB_USBNET=y

# Shared control/class dependencies.
CONFIG_USB_WDM=m
CONFIG_USB_ACM=m

# Drivers probed by switch4g.
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m

# Prevent Kconfig defaults/selectors from promoting CDC NCM/ECM back to built-in.
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_ZAURUS=m
CONFIG_USB_VL600=m
