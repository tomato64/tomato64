From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lance Fredrickson <lancethepants@gmail.com>
Date: Thu, 22 Oct 2026 11:14:49 -0600
Subject: [PATCH] wifi: mac80211: set tx power per radio of a multi-radio wiphy

On a multi-radio wiphy (mt7996: one phy for 2.4, 5 and 6 GHz) the tx power
could only be set for the whole wiphy, so OpenWrt's per-radio txpower
option made the last radio configured win for all bands.

Accept NL80211_ATTR_WIPHY_RADIO_INDEX together with the tx power
attributes. mac80211 keeps a level per radio and applies it to every
link whose channel context is on that radio, including links that are
assigned a channel later. A wiphy-wide setting clears the per-radio
levels, so the existing behaviour is unchanged for single-radio
wiphys and for callers that do not pass a radio index.

Also stop a tx-power-only radio request from resetting that radio's
RTS threshold to 0.

Based on the dropped "wifi: cfg80211/mac80211: set tx power per radio
in a wiphy" patches from Rameshkumar Sundaram (ath12k, Jan 2025).
---
 net/mac80211/cfg.c         | 58 ++++++++++++++++++++++++++++++++++++++
 net/mac80211/ieee80211_i.h |  2 ++
 net/mac80211/iface.c       | 15 ++++++++--
 net/mac80211/main.c        | 14 +++++++++
 net/wireless/nl80211.c     | 27 ++++++++++++++++++
 5 files changed, 113 insertions(+), 3 deletions(-)

diff --git a/net/mac80211/cfg.c b/net/mac80211/cfg.c
index 5e650ca..52adcdf 100644
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -3347,6 +3347,50 @@ static int ieee80211_set_wiphy_params(struct wiphy *wiphy, int radio_idx,
 	return 0;
 }
 
+static void ieee80211_set_radio_tx_power(struct ieee80211_local *local,
+					 int radio_idx,
+					 enum nl80211_tx_power_setting txp_type,
+					 int user_power_level)
+{
+	struct ieee80211_sub_if_data *sdata;
+
+	local->radio_user_power_level[radio_idx] = user_power_level;
+
+	list_for_each_entry(sdata, &local->interfaces, list) {
+		if (sdata->vif.type == NL80211_IFTYPE_MONITOR &&
+		    !ieee80211_hw_check(&local->hw, NO_VIRTUAL_MONITOR))
+			continue;
+
+		for (int link_id = 0;
+		     link_id < ARRAY_SIZE(sdata->link);
+		     link_id++) {
+			struct ieee80211_link_data *link =
+				sdata_dereference(sdata->link[link_id], sdata);
+			struct ieee80211_chanctx_conf *conf;
+			bool update_txp_type = false;
+
+			if (!link)
+				continue;
+
+			/*
+			 * A link without a channel context picks up its
+			 * radio's level when it is assigned one.
+			 */
+			conf = sdata_dereference(link->conf->chanctx_conf,
+						 sdata);
+			if (!conf || conf->radio_idx != radio_idx)
+				continue;
+
+			if (txp_type != link->conf->txpower_type) {
+				update_txp_type = true;
+				link->conf->txpower_type = txp_type;
+			}
+
+			ieee80211_recalc_txpower(link, update_txp_type);
+		}
+	}
+}
+
 static int ieee80211_set_tx_power(struct wiphy *wiphy,
 				  struct wireless_dev *wdev, int radio_idx,
 				  enum nl80211_tx_power_setting type, int mbm)
@@ -3376,6 +3420,16 @@ static int ieee80211_set_tx_power(struct wiphy *wiphy,
 		return -EINVAL;
 	}
 
+	if (radio_idx >= 0) {
+		if (!local->radio_user_power_level ||
+		    radio_idx >= wiphy->n_radio)
+			return -EINVAL;
+
+		ieee80211_set_radio_tx_power(local, radio_idx, txp_type,
+					     user_power_level);
+		return 0;
+	}
+
 	if (wdev) {
 		sdata = IEEE80211_WDEV_TO_SUB_IF(wdev);
 
@@ -3413,6 +3467,10 @@ static int ieee80211_set_tx_power(struct wiphy *wiphy,
 
 	local->user_power_level = user_power_level;
 
+	/* a wiphy-wide level replaces any per-radio level */
+	for (int i = 0; local->radio_user_power_level && i < wiphy->n_radio; i++)
+		local->radio_user_power_level[i] = IEEE80211_UNSET_POWER_LEVEL;
+
 	list_for_each_entry(sdata, &local->interfaces, list) {
 		if (sdata->vif.type == NL80211_IFTYPE_MONITOR &&
 		    !ieee80211_hw_check(&local->hw, NO_VIRTUAL_MONITOR)) {
diff --git a/net/mac80211/ieee80211_i.h b/net/mac80211/ieee80211_i.h
index 38968e4..bb0c38b 100644
--- a/net/mac80211/ieee80211_i.h
+++ b/net/mac80211/ieee80211_i.h
@@ -1654,6 +1654,8 @@ struct ieee80211_local {
 	int dynamic_ps_forced_timeout;
 
 	int user_power_level; /* in dBm, for all interfaces */
+	/* in dBm, per radio of a multi-radio wiphy; overrides user_power_level */
+	int *radio_user_power_level;
 
 	struct work_struct restart_work;
 
diff --git a/net/mac80211/iface.c b/net/mac80211/iface.c
index 0fea388..0e88ede 100644
--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -46,8 +46,9 @@ static void ieee80211_iface_work(struct wiphy *wiphy, struct wiphy_work *work);
 
 bool __ieee80211_recalc_txpower(struct ieee80211_link_data *link)
 {
+	struct ieee80211_local *local = link->sdata->local;
 	struct ieee80211_chanctx_conf *chanctx_conf;
-	int power;
+	int power, user_power_level, radio_idx;
 
 	rcu_read_lock();
 	chanctx_conf = rcu_dereference(link->conf->chanctx_conf);
@@ -57,10 +58,18 @@ bool __ieee80211_recalc_txpower(struct ieee80211_link_data *link)
 	}
 
 	power = ieee80211_chandef_max_power(&chanctx_conf->def);
+	radio_idx = chanctx_conf->radio_idx;
 	rcu_read_unlock();
 
-	if (link->user_power_level != IEEE80211_UNSET_POWER_LEVEL)
-		power = min(power, link->user_power_level);
+	user_power_level = link->user_power_level;
+	if (local->radio_user_power_level && radio_idx >= 0 &&
+	    radio_idx < local->hw.wiphy->n_radio &&
+	    local->radio_user_power_level[radio_idx] !=
+	    IEEE80211_UNSET_POWER_LEVEL)
+		user_power_level = local->radio_user_power_level[radio_idx];
+
+	if (user_power_level != IEEE80211_UNSET_POWER_LEVEL)
+		power = min(power, user_power_level);
 
 	if (link->ap_power_level != IEEE80211_UNSET_POWER_LEVEL)
 		power = min(power, link->ap_power_level);
diff --git a/net/mac80211/main.c b/net/mac80211/main.c
index 2b9a3bd..4b1e197 100644
--- a/net/mac80211/main.c
+++ b/net/mac80211/main.c
@@ -1148,6 +1148,18 @@ int ieee80211_register_hw(struct ieee80211_hw *hw)
 		    (!local->ops->start_nan || !local->ops->stop_nan)))
 		return -EINVAL;
 
+	if (hw->wiphy->n_radio > 0 && !local->radio_user_power_level) {
+		local->radio_user_power_level =
+			kcalloc(hw->wiphy->n_radio,
+				sizeof(*local->radio_user_power_level),
+				GFP_KERNEL);
+		if (!local->radio_user_power_level)
+			return -ENOMEM;
+		for (i = 0; i < hw->wiphy->n_radio; i++)
+			local->radio_user_power_level[i] =
+				IEEE80211_UNSET_POWER_LEVEL;
+	}
+
 	if (hw->wiphy->flags & WIPHY_FLAG_SUPPORTS_MLO) {
 		/*
 		 * For drivers capable of doing MLO, assume modern driver
@@ -1724,6 +1736,8 @@ void ieee80211_free_hw(struct ieee80211_hw *hw)
 		kfree(local->hw.wiphy->bands[band]);
 	}
 
+	kfree(local->radio_user_power_level);
+
 	wiphy_free(local->hw.wiphy);
 }
 EXPORT_SYMBOL(ieee80211_free_hw);
diff --git a/net/wireless/nl80211.c b/net/wireless/nl80211.c
index 14e6193..0b41e1d 100644
--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -3852,6 +3852,33 @@ static int nl80211_set_wiphy_radio(struct genl_info *info,
 	u32 rts_threshold = 0, old_rts, changed = 0;
 	int result;
 
+	if (info->attrs[NL80211_ATTR_WIPHY_TX_POWER_SETTING]) {
+		enum nl80211_tx_power_setting type;
+		int idx, mbm = 0;
+
+		if (!rdev->ops->set_tx_power)
+			return -EOPNOTSUPP;
+
+		idx = NL80211_ATTR_WIPHY_TX_POWER_SETTING;
+		type = nla_get_u32(info->attrs[idx]);
+
+		if (!info->attrs[NL80211_ATTR_WIPHY_TX_POWER_LEVEL] &&
+		    (type != NL80211_TX_POWER_AUTOMATIC))
+			return -EINVAL;
+
+		if (type != NL80211_TX_POWER_AUTOMATIC) {
+			idx = NL80211_ATTR_WIPHY_TX_POWER_LEVEL;
+			mbm = nla_get_u32(info->attrs[idx]);
+		}
+
+		result = rdev_set_tx_power(rdev, NULL, radio_idx, type, mbm);
+		if (result)
+			return result;
+
+		if (!info->attrs[NL80211_ATTR_WIPHY_RTS_THRESHOLD])
+			return 0;
+	}
+
 	if (!rdev->ops->set_wiphy_params)
 		return -EOPNOTSUPP;
 
