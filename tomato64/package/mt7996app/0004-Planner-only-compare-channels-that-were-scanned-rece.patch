+/// Follow `iw event` for finished scans (whoever started them: hostapd ACS, a
+/// site survey, `iw scan`), so the planner knows which channels were looked at
+/// and when. Restarted if iw exits; iw dies with this thread.
+fn watch_scans(iw: String, out: Arc<Mutex<Vec<ScanVisit>>>) {
+    std::thread::spawn(move || loop {
+        let mut cmd = Command::new(&iw);
+        cmd.arg("event").stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::null());
