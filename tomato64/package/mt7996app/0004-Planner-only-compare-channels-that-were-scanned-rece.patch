+/// Whether the radio is on `freq` or visited it within MAX_SCAN_AGE.
+/// `None`: the interface has no survey data, so this cannot be told.
+fn visited(survey: &[SurveyChan], seen: Option<&HashMap<u32, f64>>, now: f64, freq: u32) -> Option<bool> {
+    if survey.is_empty() {
+        return None;
+    }
+    if survey.iter().any(|c| c.freq == freq && c.in_use) {
+        return Some(true);
+    }
+    Some(seen.and_then(|m| m.get(&freq)).is_some_and(|t| now - t <= MAX_SCAN_AGE_S))
+}
+
+/// What the planner has seen, kept longer than the kernel keeps it.
+///
+/// * BSSes: every `scan dump` is merged in by BSSID with the time it was last
+///   heard, and kept for MAX_SCAN_AGE.
+/// * Visits: a channel counts as visited while it is in use, and when a scan
+///   that covered it finishes (`iw event`). The survey cannot tell this:
+///   mt76 overwrites a channel's active time with the last dwell (so it does
+///   not grow), and on start it is of unknown age.
+#[derive(Default)]
+pub struct ScanMemory {
+    bss: HashMap<(String, String), (Bss, f64)>,
+    last_ts: Option<f64>,
+    pub visited: HashMap<String, HashMap<u32, f64>>,
+}
+
+impl ScanMemory {
+    pub fn update(&mut self, now: f64, scan: Option<&ScanData>, survey: &HashMap<String, Vec<SurveyChan>>, visits: &[ScanVisit]) {
+        if let Some(s) = scan {
+            self.last_ts = Some(self.last_ts.map_or(s.ts, |t| t.max(s.ts)));
+            for (iface, list) in &s.per_iface {
+                for b in list {
+                    let heard = now - b.seen_ms.unwrap_or(0) as f64 / 1000.0;
+                    let e = self.bss.entry((iface.clone(), b.bssid.clone())).or_insert((b.clone(), heard));
+                    if heard >= e.1 {
+                        *e = (b.clone(), heard);
+                    }
+                }
+            }
+        }
+        self.bss.retain(|_, (_, t)| now - *t <= MAX_SCAN_AGE_S);
+
+        for v in visits {
+            let m = self.visited.entry(v.iface.clone()).or_default();
+            for f in &v.freqs {
+                m.insert(*f, v.ts);
+            }
+        }
+        for (iface, chans) in survey {
+            for c in chans.iter().filter(|c| c.in_use) {
+                self.visited.entry(iface.clone()).or_default().insert(c.freq, now);
+            }
+        }
+        for m in self.visited.values_mut() {
+            m.retain(|_, t| now - *t <= MAX_SCAN_AGE_S);
+        }
+    }
+
+    /// The remembered BSSes as a scan cache, `seen_ms` relative to `now`.
+    pub fn scan(&self, now: f64) -> Option<ScanData> {
+        let ts = self.last_ts?;
+        let mut per_iface: HashMap<String, Vec<Bss>> = HashMap::new();
+        for ((iface, _), (b, t)) in &self.bss {
+            let mut b = b.clone();
+            b.seen_ms = Some(((now - t).max(0.0) * 1000.0) as u64);
+            per_iface.entry(iface.clone()).or_default().push(b);
+        }
+        for v in per_iface.values_mut() {
+            v.sort_by(|a, b| a.freq.cmp(&b.freq).then(a.bssid.cmp(&b.bssid)));
+        }
+        Some(ScanData { ts, per_iface })
+    }
+}
