+    #[test]
+    fn unscanned_channels_are_not_recommended() {
+        // on 36-48 with a strong neighbour on 36; 52-64 never visited, 100-112
+        // visited and quiet
+        let scan = ScanData { ts: 100.0, per_iface: HashMap::from([("wlan0".to_string(), vec![bss("aa:aa:aa:aa:aa:01", 5180, -40.0)])]) };
+        let chans = HashMap::from([("phy0".to_string(), chans_5g())]);
+        let radios = [radio()];
+        // the current block is also busy (survey), so a quiet DFS block beats
+        // it despite the DFS penalty
+        let mut sur: Vec<SurveyChan> =
+            (0..4u32).map(|i| SurveyChan { busy_ms: Some(800), ..sv(5180 + 20 * i, 1000, i == 0) }).collect();
+        sur.extend((0..4u32).map(|i| sv(5260 + 20 * i, 0, false)));
+        let survey = HashMap::from([("wlan0".to_string(), sur.clone())]);
+        // 36-48 visited just now, 52-64 only 20 min ago (too old)
+        let mut vis = HashMap::from([("wlan0".to_string(), (0..4u32).map(|i| (5180 + 20 * i, 120.0)).collect::<HashMap<u32, f64>>())]);
+        vis.get_mut("wlan0").unwrap().extend((0..4u32).map(|i| (5260 + 20 * i, 130.0 - 1200.0)));
+        let p = build_plan(&PlanInput { now: 130.0, radios: &radios, scan: Some(&scan), survey: &survey, visited: &vis, phy_chans: &chans });
+        let l = &p.links[0];
+        assert!(l.recommend.is_none(), "{:?}", l.recommend);
+        let c52 = l.candidates.iter().find(|c| c.center1 == 5290).unwrap();
+        assert!(!c52.scanned);
+        assert!(l.candidates.iter().find(|c| c.current).unwrap().scanned);
+        assert!(p.notes.iter().any(|n| n.contains("not scanned in the last 15 min")));
+
+        // once 100-112 has been visited (and is quiet) it may be recommended
+        sur.extend((0..4u32).map(|i| sv(5500 + 20 * i, 60, false)));
+        let survey = HashMap::from([("wlan0".to_string(), sur)]);
+        vis.get_mut("wlan0").unwrap().extend((0..4u32).map(|i| (5500 + 20 * i, 125.0)));
+        let p = build_plan(&PlanInput { now: 130.0, radios: &radios, scan: Some(&scan), survey: &survey, visited: &vis, phy_chans: &chans });
+        assert_eq!(p.links[0].recommend.as_ref().map(|c| c.center1), Some(5530));
+
+        // no survey at all: cannot tell, old behaviour
+        let p = build_plan(&PlanInput { now: 130.0, radios: &radios, scan: Some(&scan), survey: &HashMap::new(), visited: &HashMap::new(), phy_chans: &chans });
+        assert!(p.links[0].candidates.iter().all(|c| c.scanned));
+    }
+
+    #[test]
+    fn scan_memory_outlives_the_kernel_cache() {
+        let mut m = ScanMemory::default();
+        let survey = HashMap::from([(
+            "w".to_string(),
+            vec![
+                SurveyChan { freq: 2412, active_ms: Some(114), ..Default::default() },
+                SurveyChan { freq: 2437, in_use: true, active_ms: Some(9000), ..Default::default() },
+            ],
+        )]);
+        let visit = |freqs: Vec<u32>, ts: f64| vec![ScanVisit { iface: "w".into(), freqs, ts }];
+
+        // survey active time alone (unknown age) is not a visit; in use is
+        let scan = ScanData { ts: 1000.0, per_iface: HashMap::from([("w".to_string(), vec![bss("aa:00:00:00:00:01", 2412, -60.0)])]) };
+        m.update(1000.0, Some(&scan), &survey, &[]);
+        assert!(m.visited["w"].contains_key(&2437));
+        assert!(!m.visited["w"].contains_key(&2412));
+
+        // a finished scan covers exactly its frequencies; the kernel then forgets the BSS
+        m.update(1010.0, None, &survey, &visit(vec![2412, 2462], 1009.0));
+        assert_eq!((m.visited["w"][&2412], m.visited["w"][&2462]), (1009.0, 1009.0));
+        let s = m.scan(1300.0).unwrap();
+        assert_eq!(s.per_iface["w"].len(), 1);
+        assert_eq!(s.per_iface["w"][0].seen_ms, Some(301_000)); // heard 1 s before t=1000
+
+        // after MAX_SCAN_AGE both the BSS and the visit are gone
+        m.update(1000.0 + MAX_SCAN_AGE_S + 20.0, None, &survey, &[]);
+        assert!(m.scan(2000.0).unwrap().per_iface.is_empty());
+        assert!(!m.visited["w"].contains_key(&2412));
+        assert!(m.visited["w"].contains_key(&2437)); // in use: always fresh
+    }
 }
