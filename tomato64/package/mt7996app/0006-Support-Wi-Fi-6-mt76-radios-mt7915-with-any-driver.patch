diff --git a/src/planner.rs b/src/planner.rs
index 8ce1f5f..7e8264e 100644
--- a/src/planner.rs
+++ b/src/planner.rs
@@ -357,7 +357,15 @@ pub fn build_plan(inp: &PlanInput) -> Plan {
             }
         }
     }
-    for r in inp.radios {
+    // Several interfaces (guest, IoT, mesh) on one radio (or MLO link) share its channel: plan it
+    // once, from an AP interface with the most clients (a mesh point may report a narrower width).
+    let mut order: Vec<&Radio> = inp.radios.iter().collect();
+    order.sort_by_key(|r| (r.kind.as_deref() != Some("AP"), std::cmp::Reverse(r.stations)));
+    let mut planned: HashSet<(String, Option<u32>)> = HashSet::new();
+    let mut picked: Vec<&Radio> = order.into_iter().filter(|r| r.phy.as_ref().is_none_or(|p| planned.insert((p.clone(), r.link)))).collect();
+    // keep the radios' own order in the output
+    picked.sort_by_key(|r| inp.radios.iter().position(|x| std::ptr::eq(x, *r)));
+    for r in picked {
         let (Some(freq), Some(width)) = (r.freq, r.width) else { continue };
         let band = r.band.unwrap_or("5G");
         let window = if band == "2.4G" { 15.0 } else { 10.0 };
@@ -376,7 +384,9 @@ pub fn build_plan(inp: &PlanInput) -> Plan {
             ((bs.iter().map(|b| b.load + survey_busy(survey, b.freq)).sum::<f64>()) * 100.0).round() / 100.0
         };
         let current_score = score_of(&bins);
+        // preamble puncturing of the whole BSS is a Wi-Fi 7 (EHT) feature
         let (puncture, puncture_note) = match r.center1 {
+            Some(_) if r.eht == Some(false) => (None, None),
             Some(c1) => recommend_puncture(width, c1, freq, &bins),
             None => (None, None),
         };
@@ -436,7 +446,9 @@ pub fn build_plan(inp: &PlanInput) -> Plan {
             ));
         }
         cands.truncate(6);
-        if cands.is_empty() && chans.is_empty() {
+        if band == "2.4G" && width > 20 {
+            plan.notes.push(format!("{}: channel advice on 2.4 GHz is only given for 20 MHz channels (1, 6, 11)", r.iface));
+        } else if cands.is_empty() && chans.is_empty() {
             plan.notes.push(format!("{}: channel list of {} unavailable, only puncturing is evaluated", r.iface, r.phy.as_deref().unwrap_or("?")));
         }
         plan.links.push(LinkPlan {
@@ -549,6 +561,26 @@ mod tests {
         assert_eq!(l.clear_mhz, 40);
         let pr = l.puncture.as_ref().unwrap();
         assert_eq!((pr.bitmap, pr.bitmap_hex.as_str(), pr.clear_before_mhz, pr.clear_after_mhz, pr.gain_mhz), (0x8, "0x8", 40, 60, 20));
+
+        // the same channel on a Wi-Fi 6 BSS: no puncturing advice
+        let radios = [Radio { eht: Some(false), ..radio() }];
+        let p = build_plan(&PlanInput { now: 130.0, radios: &radios, scan: Some(&scan), survey: &survey, visited: &vis, phy_chans: &chans });
+        assert!(p.links[0].puncture.is_none() && p.links[0].puncture_note.is_none());
+    }
+
+    #[test]
+    fn one_plan_per_radio_channel() {
+        let chans = HashMap::from([("phy0".to_string(), chans_5g())]);
+        let (survey, vis) = (HashMap::new(), HashMap::new());
+        let ap = |iface: &str, phy: &str, stations: usize| Radio { iface: iface.into(), phy: Some(phy.into()), kind: Some("AP".into()), stations, ..radio() };
+        let radios = [
+            Radio { iface: "mesh".into(), kind: Some("mesh point".into()), width: Some(20), center1: Some(5180), ..radio() },
+            ap("guest", "phy0", 0),
+            ap("wlan0", "phy0", 4),
+            ap("other", "phy1", 0),
+        ];
+        let p = build_plan(&PlanInput { now: 1.0, radios: &radios, scan: None, survey: &survey, visited: &vis, phy_chans: &chans });
+        assert_eq!(p.links.iter().map(|l| (l.iface.as_str(), l.width)).collect::<Vec<_>>(), vec![("wlan0", 80), ("other", 80)]);
     }
 
     fn sv(freq: u32, active: u64, in_use: bool) -> SurveyChan {
diff --git a/static/index.html b/static/index.html
