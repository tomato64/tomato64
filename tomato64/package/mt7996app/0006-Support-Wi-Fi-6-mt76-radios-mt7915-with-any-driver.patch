 src/events.rs     |  5 ++++-
 src/hostapd.rs    |  5 +++--
 src/model.rs      |  2 ++
 src/planner.rs    | 36 ++++++++++++++++++++++++++++++++++--
 static/index.html |  8 +++++++-
 6 files changed, 53 insertions(+), 6 deletions(-)

