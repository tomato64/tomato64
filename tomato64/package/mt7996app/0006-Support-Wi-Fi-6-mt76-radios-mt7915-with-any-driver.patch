+// a client without per-link data on a non-MLD interface uses that interface's only band
+function staBand(st, s) {
+  const bands = [...new Set(st.radios.filter(r => r.iface === s.iface).map(r => r.band).filter(Boolean))];
+  return bands.length === 1 ? `<span class="band ${bandCls(bands[0])}">${esc(bands[0])}</span>` : "–";
+}
