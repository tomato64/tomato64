+/// `--listen` / `MT7996APP_LISTEN`: `unix:PATH` selects a unix socket, anything else
+/// goes through `parse_listen`.
+fn set_listen(a: &mut Args, s: &str) -> Result<(), String> {
+    if let Some(path) = s.strip_prefix("unix:") {
+        if path.is_empty() {
+            return Err("unix: needs a socket path".into());
+        }
+        a.unix = Some(path.to_string());
+    } else {
+        (a.bind, a.port) = parse_listen(s, &a.bind)?;
+        a.unix = None;
+    }
+    Ok(())
+}
