#!/bin/sh

set -e

. /usr/sbin/nvram_ops
. /usr/sbin/net_utils

if [ "$(NG set_macs)" == "0" ]; then

	for i in `ls /sys/class/net/`;
	do
		if [[ "$i" == "eth"* ]]; then
			NS ${i}macaddr=$(cat /sys/class/net/${i}/address | tr '[:lower:]' '[:upper:]')
		fi
	done

	wanif=eth0
	if grep -qs 'glinet,gl-be14000' /proc/device-tree/compatible; then
		wanif=eth1
	fi

	for i in wan_hwaddr wan_mac;
	do
		NS ${i}=`ifconfig ${wanif} | grep -o -E ..:..:..:..:..:..`
	done

	NS set_macs=1
fi

if [ "$(NG et0macaddr)" == "" ]; then
	NS et0macaddr=`ifconfig eth1 | grep -o -E ..:..:..:..:..:..`
fi

if grep -qs 'brcm,bcm4708' /proc/device-tree/compatible; then
	for n in 2 3 4; do
		if [ -z "$(NG wan${n}_mac)" ]; then
			NS "wan${n}_mac=$(macaddr_add "$(NG et0macaddr)" $((15 + n)))"
		fi
	done
fi
