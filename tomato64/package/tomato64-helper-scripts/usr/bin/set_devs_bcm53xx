#!/bin/sh

set -e
set -x

. /usr/sbin/nvram_ops
. /usr/sbin/net_utils

# BCM53XX devices use DSA (Distributed Switch Architecture)
# The kernel creates: eth0 (gmac0), eth1 (gmac1), eth2 (gmac2),
#                     wan, lan1-lan4 (switch ports)
# One GMAC is the DSA conduit (CPU port): gmac0 on boards whose DTS uses
# switch port 5, gmac1 for port 7, gmac2 for port 8 (the IMP port).
# Tomato64 convention: WAN=eth0, LAN1=eth1, LAN2=eth2, etc.
#
# Problem: eth0/eth1/eth2 (GMAC interfaces) collide with desired DSA port
# names. We assign unique MACs to all interfaces so ifrename can rename them:
#   conduit GMAC             -> switch0  (basemac+10)
#   eth1 (gmac1, unused)     -> gmac1    (basemac+11)
#   eth2 (gmac2, unused)     -> gmac2    (basemac+12)
#   eth0 (gmac0, unused)     -> gmac0    (basemac+13)
#   wan                      -> eth0     (basemac+16)
#   lan1                     -> eth1     (basemac+48)
#   lan2                     -> eth2     (basemac+49)
#   lan3                     -> eth3     (basemac+50)
#   lan4                     -> eth4     (basemac+51)

# Wait for the GMAC interfaces
if ! wait_for_interface eth0; then
	logger -t set_devs_bcm53xx "ERROR: eth0 did not appear after 10 seconds"
fi
wait_for_interface eth1 5 2>/dev/null || true
wait_for_interface eth2 5 2>/dev/null || true

# Wait for DSA WAN and LAN ports
wait_for_interface wan 5 2>/dev/null || true
for p in lan1 lan2 lan3 lan4; do
	wait_for_interface "$p" 2 2>/dev/null || true
done

# Find the conduit: the GMAC the DSA ports' iflink points at
conduit=""
for p in wan lan1 lan2 lan3 lan4; do
	[ -e "/sys/class/net/$p/iflink" ] || continue
	iflink=$(cat "/sys/class/net/$p/iflink")
	for g in eth0 eth1 eth2; do
		if [ "$(cat /sys/class/net/$g/ifindex 2>/dev/null)" = "$iflink" ]; then
			conduit=$g
			break 2
		fi
	done
done

if [ -z "$conduit" ]; then
	logger -t set_devs_bcm53xx "ERROR: could not find the DSA conduit, assuming eth0"
	conduit=eth0
fi

# Read base MAC from eth0 (gmac0, et0macaddr), whichever GMAC is the conduit
basemac=$(cat /sys/class/net/eth0/address 2>/dev/null | tr '[:lower:]' '[:upper:]')

if [ -z "$basemac" ]; then
	logger -t set_devs_bcm53xx "ERROR: Could not read eth0 MAC address"
	basemac="00:00:00:00:00:00"
fi

# Name and MAC for each GMAC (offset +10..+13 to avoid collisions)
: > /etc/iftab
for i in 0 1 2; do
	g=eth$i
	[ -d "/sys/class/net/$g" ] || continue
	if [ "$g" = "$conduit" ]; then
		name=switch0
		mac=$(macaddr_add "$basemac" 10)
	else
		name=gmac$i
		case $i in
		0) mac=$(macaddr_add "$basemac" 13) ;;
		*) mac=$(macaddr_add "$basemac" $((10 + i))) ;;
		esac
	fi
	# Reassign GMAC MACs to unique values (must happen every boot)
	ip link set dev "$g" address "$mac"
	echo "$name mac $mac" >> /etc/iftab
done

# Compute MACs for DSA ports
wanmac=$(macaddr_add "$basemac" 16)
lan1mac=$(macaddr_add "$basemac" 48)
lan2mac=$(macaddr_add "$basemac" 49)
lan3mac=$(macaddr_add "$basemac" 50)
lan4mac=$(macaddr_add "$basemac" 51)

# Set MACs on DSA switch port interfaces
ip link set dev wan address "$wanmac"
ip link set dev lan1 address "$lan1mac"
ip link set dev lan2 address "$lan2mac"
ip link set dev lan3 address "$lan3mac"
ip link set dev lan4 address "$lan4mac"

# Write iftab for ifrename: map MACs to desired final names
echo "eth0 mac $wanmac" >> /etc/iftab
echo "eth1 mac $lan1mac" >> /etc/iftab
echo "eth2 mac $lan2mac" >> /etc/iftab
echo "eth3 mac $lan3mac" >> /etc/iftab
echo "eth4 mac $lan4mac" >> /etc/iftab

if [ "$(NG set_macs)" != "1" ]; then
	NS "eth0macaddr=$wanmac"

	for i in wan_hwaddr wan_mac; do
		NS "${i}=$wanmac"
	done

	NS set_macs=1
fi

NS "et0macaddr=$basemac"
NS "lan_hwaddr=$basemac"
