#!/bin/sh
#
# Start the front-panel boot splash, which then starts the UI itself.
#
# Called from rc's init, after the filesystem expansion rather than from
# set_devs_be14000 beside the driver loads. The panel driver is ready either
# way; what this avoids is starting an LVGL loop and lighting the backlight in
# the middle of the busiest part of the boot - mt7996e pulling firmware for
# three radios, and, on the first boot after a flash, an online resize2fs of
# the mounted root. The splash only ever appeared about four seconds before
# the UI replaced it, so it costs the screen almost nothing to wait.
#
# On this board the screen stands in for the status LEDs, so stealth mode
# keeps it dark, backlight included.
#
# nvram panel_boot is the diagnostic switch, and 0 is an explicit off: see
# panel_boot for the trace and once modes.

. /usr/sbin/nvram_ops

case "$(NG panel_boot)" in
0)
	exit 0
	;;
esac

if [ "$(NG stealth_mode)" = "1" ]; then
	for bl in /sys/class/backlight/*/brightness; do
		[ -e "$bl" ] && echo 0 > "$bl"
	done

	exit 0
fi

[ -x /usr/bin/panel_boot ] || exit 0

setsid /usr/bin/panel_boot < /dev/null > /dev/null 2>&1 &

exit 0
